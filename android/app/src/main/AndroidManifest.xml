<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Both are now used: RECORD_AUDIO by the Oboe capture path, INTERNET by
         the UDP transport. LAN-only, so no other network permission applies. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Low-latency audio is a request, not a guarantee. Declaring these lets
         the platform and the Play listing know the app cares, and on devices
         that report them the AAudio exclusive path is the one Oboe will get. -->
    <uses-feature
        android:name="android.hardware.audio.low_latency"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.audio.pro"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_lock_silent_mode_off"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fdradio">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
