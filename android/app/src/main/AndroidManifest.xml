<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions yet, deliberately. RECORD_AUDIO arrives with the Oboe
         capture path and INTERNET with the transport; declaring them before
         anything uses them makes the install prompt lie about what the app
         does. -->

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_lock_silent_mode_off"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fdradio">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
