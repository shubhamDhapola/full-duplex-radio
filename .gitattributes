* text=auto eol=lf

*.png binary
*.wav binary
*.jpg binary
*.jar binary

# The Gradle wrapper. gradlew.bat is a Windows batch file and must keep CRLF or
# it will not run there; the shell script and the jar are left alone for the
# same reason -- they are generated by Gradle and are not ours to reformat.
android/gradlew text eol=lf
android/gradlew.bat text eol=crlf

# Keep generated conformance vectors out of diff noise, but still reviewable.
protocol/testvectors/vectors.json linguist-generated=true

# Don't let the vendored-free repo be misreported as another language.
*.md linguist-documentation
